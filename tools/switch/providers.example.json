        "ANTHROPIC_DEFAULT_OPUS_MODEL": "<映射到 opus 档位的模型名>",
        "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "<同上>",
        "ANTHROPIC_DEFAULT_SONNET_MODEL": "<映射到 sonnet 档位的模型名>",
        "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME": "<同上>",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "<映射到 haiku 档位的模型名>",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME": "<同上>"
